params {
    min_length = 10
    db_fasta = "${projectDir}/test_data/blast/toy_db.fasta"
    query = "${projectDir}/test_data/blast/toy_query.fasta"
    outdir = "results"
    evalue = 1e-5
    max_evalue = 1e-5
    min_identity = 30.0
    min_coverage = 0.50
    min_align_length = 30
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
    fields  = 'task_id,name,status,exit,duration,realtime,%cpu,peak_rss'
}
